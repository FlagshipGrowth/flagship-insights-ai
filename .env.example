# Copy to .env and fill in — never commit the real .env file.

# Netlify DB (Neon Postgres). Set via `netlify env:set DATABASE_URL ...` once provisioned,
# or in .env for local `netlify dev`.
DATABASE_URL=

# Separate from any Claude Code login — needed only when phase0/run_insight.py or the
# Netlify functions' AI layer actually calls the Anthropic API. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Amazon LWA (SP-API + Ads) — not usable until docs/phase1-amazon-application.md clears.
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=

# Master key for connections.tokens envelope encryption (netlify/functions/lib/crypto.ts).
# Generate with: openssl rand -base64 32 — must decode to exactly 32 bytes. Never commit
# the real value; set it via `netlify env:set CONNECTIONS_ENCRYPTION_KEY ...`.
CONNECTIONS_ENCRYPTION_KEY=

# Clerk (auth). From a Clerk project dashboard (dashboard.clerk.com) — free to create, no
# approval needed. Publishable key is safe client-side; secret key is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# From the Clerk dashboard's Webhooks page, after pointing it at
# https://<your-site>.netlify.app/api/webhooks/clerk (events: user.created, user.deleted,
# organization.created, organizationMembership.created/updated/deleted).
CLERK_WEBHOOK_SIGNING_SECRET=

# Comma-separated emails that become internal_admin on first sign-in — everyone else who
# signs up is a client user (role assigned via their Clerk organization membership instead).
INTERNAL_STAFF_EMAILS=joey@flagshipgrowth.com

# Voyage AI (embeddings for the knowledge-ingestion pipeline, netlify/functions/lib/knowledge/).
# Anthropic doesn't offer embeddings directly and recommends Voyage — get a key at voyageai.com.
VOYAGE_API_KEY=
