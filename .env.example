# Copy to .env and fill in — never commit the real .env file.

# Netlify DB (Neon Postgres) — auto-injected as NETLIFY_DB_URL once provisioned via
# `netlify database status`. Don't set this manually; there's no plain DATABASE_URL.
# See lib/db.ts / netlify/functions/lib/db.ts (getConnectionString() from @netlify/database).

# Separate from any Claude Code login — needed only when phase0/run_insight.py or the
# Netlify functions' AI layer actually calls the Anthropic API. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Amazon LWA (SP-API + Ads) — not usable until docs/phase1-amazon-application.md clears.
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=

# Master key for connections.tokens envelope encryption (netlify/functions/lib/crypto.ts).
# Generate with: openssl rand -base64 32 — must decode to exactly 32 bytes. Never commit
# the real value; set it via `netlify env:set CONNECTIONS_ENCRYPTION_KEY ...`.
CONNECTIONS_ENCRYPTION_KEY=

# Clerk (auth). From a Clerk project dashboard (dashboard.clerk.com) — free to create, no
# approval needed. Publishable key is safe client-side; secret key is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Without these, Clerk redirects to its own hosted Account Portal (a *.accounts.dev domain)
# instead of our own /sign-in, /sign-up pages — meaning brand styling never applies.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# From the Clerk dashboard's Webhooks page, after pointing it at
# https://<your-site>.netlify.app/api/webhooks/clerk (events: user.created, user.deleted,
# organization.created, organizationMembership.created/updated/deleted).
CLERK_WEBHOOK_SIGNING_SECRET=

# Comma-separated emails that become internal_admin on first sign-in — everyone else who
# signs up is a client user (role assigned via their Clerk organization membership instead).
INTERNAL_STAFF_EMAILS=joey@flagshipgrowth.com,vinny@flagshipgrowth.com

# Comma-separated emails that become account_manager instead of internal_admin (scoped to
# whichever clients an internal_admin assigns them at /internal/assignments). Checked before
# INTERNAL_STAFF_EMAILS, so an email in both lists becomes account_manager.
ACCOUNT_MANAGER_EMAILS=

# Voyage AI (embeddings for the knowledge-ingestion pipeline, netlify/functions/lib/knowledge/).
# Anthropic doesn't offer embeddings directly and recommends Voyage — get a key at voyageai.com.
VOYAGE_API_KEY=

# Google Sheets API v4 (Catalog sync, netlify/functions/lib/catalog/google-sheets.ts) — the
# service account flagship-insights-sheets-sync@amazon-weekly-reports.iam.gserviceaccount.com,
# shared as Viewer on each brand's master spec sheet. Already set in Netlify (production + dev);
# add here too for local dev. GOOGLE_SHEETS_PRIVATE_KEY keeps the key's literal "\n" escapes —
# don't paste in real newlines.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# Slack app (see lib/slack.ts / netlify/functions/lib/slack.ts). SLACK_BOT_TOKEN is "xoxb-..."
# from the app's OAuth & Permissions page; SLACK_SIGNING_SECRET from its Basic Information page;
# SLACK_ALERTS_CHANNEL_ID is the fallback channel for anything that fails to post where it meant
# to (a channel the bot hasn't been invited into, etc).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ALERTS_CHANNEL_ID=

# Claude Tag's own Slack user ID in this workspace (app/api/slack/events/route.ts,
# seo-listing-finalize-background.ts) — only set once Claude Tag is invited to the workspace
# (claude.ai/admin-settings/claude-tag). Used two ways: to @-mention it in the /seo-listing
# request so it picks the work up automatically, and to recognize its threaded replies (vs. any
# other message) so seo-listing-capture-reply-background.ts only acts on those. Find it the same
# way any Slack user ID is found once Claude Tag is a member (e.g. a member-list/API lookup).
CLAUDE_TAG_SLACK_USER_ID=

# Outbound Sales Engine: shared secret the outbound-sourcing agent sends as a Bearer token to
# /api/outbound/ingest. Any long random string (e.g. `openssl rand -hex 32`); the agent reads the
# same value from a local, gitignored .outbound-sync-secret file.
OUTBOUND_SYNC_SECRET=
