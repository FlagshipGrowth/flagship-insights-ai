# Copy to .env and fill in — never commit the real .env file.

# Netlify DB (Neon Postgres). Set via `netlify env:set DATABASE_URL ...` once provisioned,
# or in .env for local `netlify dev`.
DATABASE_URL=

# Separate from any Claude Code login — needed only when phase0/run_insight.py or the
# Netlify functions' AI layer actually calls the Anthropic API. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Amazon LWA (SP-API + Ads) — not usable until docs/phase1-amazon-application.md clears.
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=

# Master key for connections.tokens envelope encryption (netlify/functions/lib/crypto.ts).
# Generate with: openssl rand -base64 32 — must decode to exactly 32 bytes. Never commit
# the real value; set it via `netlify env:set CONNECTIONS_ENCRYPTION_KEY ...`.
CONNECTIONS_ENCRYPTION_KEY=
